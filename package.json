{
  "name": "vivace-angular",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "build": "ng build",
    "preview": "ng serve --configuration production --port ${VIVACE_FRONTEND_PORT:-3000}",
    "lint": "ng build --configuration development",
    "db:cluster": "node db/dev-cluster.mjs start",
    "db:migrate": "node db/migrate.mjs",
    "db:import": "node db/import-from-json.mjs",
    "db:verify": "node db/verify-parity.mjs",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@angular/aria": "21.2.14",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.22",
    "@angular/compiler": "21.2.22",
    "@angular/core": "21.2.22",
    "@angular/forms": "21.2.22",
    "@angular/platform-browser": "21.2.22",
    "highcharts": "13.0.2",
    "highcharts-angular": "5.4.1",
    "pg": "^8.23.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.22",
    "@angular/cli": "21.2.22",
    "@angular/compiler-cli": "21.2.22",
    "@tailwindcss/postcss": "^4.1.14",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3"
  }
}
