# Porta do frontend Angular.
VIVACE_FRONTEND_PORT=3000

# Porta da API de persistência.
# Antes de iniciar, verifique se a porta está livre com: ss -tln | grep :3001
VIVACE_API_PORT=3001

# Pasta dos dados compartilhados entre dispositivos.
# Em uso apenas pelo import de migracao (npm run db:import); o servidor passa a
# ler do Postgres.
VIVACE_DATA_DIRECTORY=.data

# Conexao usada pela aplicacao. Este papel NAO e dono das tabelas: e assim que
# as policies de RLS passam a valer, ja que o dono ignora as policies.
DATABASE_URL=postgres://vivace_api:vivace@127.0.0.1:55432/vivace
# Conexao usada pelas migracoes, que precisam criar tabelas e indexes.
MIGRATION_DATABASE_URL=postgres://vivace:vivace@127.0.0.1:55432/vivace

# Inicia apenas a API, sem o frontend Angular.
VIVACE_SKIP_FRONTEND=false

# Validade da sessão em milissegundos (padrão: 8 horas).
VIVACE_SESSION_TTL_MS=28800000

# Limite de tentativas de login. As falhas são contadas por IP e por conta.
# Ao estourar VIVACE_LOGIN_MAX_ATTEMPTS, a API responde 429 com Retry-After.
VIVACE_LOGIN_MAX_ATTEMPTS=5
# Janela em que as falhas são somadas e duração do bloqueio (padrão: 15 minutos).
VIVACE_LOGIN_WINDOW_MS=900000
VIVACE_LOGIN_LOCKOUT_MS=900000

# Administrador criado no primeiro acesso. Troque a senha em produção.
VIVACE_BOOTSTRAP_EMAIL=admin@vivace.med.br
VIVACE_BOOTSTRAP_PASSWORD=vivace-demo

# Origens extras liberadas no CORS, separadas por vírgula.
VIVACE_ALLOWED_ORIGINS=
