# Porta do frontend Angular.
VIVACE_FRONTEND_PORT=3000

# Porta da API de persistência.
# Antes de iniciar, verifique se a porta está livre com: ss -tln | grep :3001
VIVACE_API_PORT=3001

# Pasta dos dados compartilhados entre dispositivos.
VIVACE_DATA_DIRECTORY=.data

# Inicia apenas a API, sem o frontend Angular.
VIVACE_SKIP_FRONTEND=false

# Validade da sessão em milissegundos (padrão: 8 horas).
VIVACE_SESSION_TTL_MS=28800000

# Administrador criado no primeiro acesso. Troque a senha em produção.
VIVACE_BOOTSTRAP_EMAIL=admin@vivace.med.br
VIVACE_BOOTSTRAP_PASSWORD=vivace-demo

# Origens extras liberadas no CORS, separadas por vírgula.
VIVACE_ALLOWED_ORIGINS=
